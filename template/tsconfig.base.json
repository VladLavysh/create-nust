{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@nust/shared": ["./packages/shared/dist/index.d.ts"],
      "@nust/shared/*": ["./packages/shared/dist/*"],
      "@nust/web/*": ["./apps/web/app/*"],
      "@nust/api/*": ["./apps/api/src/*"],
      "@/*": ["./"],
    },
  },
}
